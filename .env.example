# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#
# SECURITY NOTE
# -------------
# This project is READ-ONLY against Kalshi. It uses the API purely as a live
# market-data source and contains no order-placement code whatsoever.
# Agents trade simulated money only; the real Kalshi account is never touched.
#
# The private key file is intentionally NOT stored inside this repository.
# Point KALSHI_PRIVATE_KEY_PATH at wherever the .pem already lives on disk.

KALSHI_KEY_ID=your-key-id-uuid-here
KALSHI_PRIVATE_KEY_PATH=C:\path\to\your\kalshi_private_key.pem

# Local dashboard port
DASHBOARD_PORT=8000
